{
  "name": "@poe-ai/plugin-archetypes",
  "version": "0.1.0",
  "description": "Patch-versioned build archetype knowledge base + deterministic classifier for poe-ai",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "src/data"
  ],
