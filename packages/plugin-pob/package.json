{
  "name": "@poe-ai/plugin-pob",
  "version": "0.1.0",
  "description": "Path of Building integration plugin for poe-ai",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./scripts/download-pob.js": "./scripts/download-pob.js",
    "./scripts/download-luajit.js": "./scripts/download-luajit.js"
  },
  "files": [
    "dist",
    "scripts/download-pob.js",
    "scripts/download-luajit.js",
    "scripts/pob-bridge.lua"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "download-pob": "node scripts/download-pob.js",
    "download-luajit": "node scripts/download-luajit.js",
    "setup": "node scripts/download-pob.js && node scripts/download-luajit.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "zod": "3",
    "tar": "^7.5.2"
  },
  "peerDependencies": {
    "@poe-ai/core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^4.0.13",
    "@types/node": "^24.10.1",
    "@poe-ai/core": "workspace:*"
  }
}
