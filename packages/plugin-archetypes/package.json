  },
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "@poe-ai/core": "workspace:*",
    "zod": "3"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^4.0.13",
    "@types/node": "^24.10.1",
    "@poe-ai/core": "workspace:*",
    "@poe-ai/plugin-pob": "workspace:*",
    "semver": "^7.7.1",
    "@types/semver": "^7.5.8"
  }
