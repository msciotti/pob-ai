{
  "name": "@poe-ai/game-data",
  "version": "0.1.0",
  "description": "Lazy, memoized loaders over local RePoE game data exports (mods, tags, base items, fossils, essences, crafting bench options) -- a plain library, not a plugin",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./scripts/download-repoe.js": "./scripts/download-repoe.js"
  },
  "files": [
    "dist",
    "scripts"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "download-repoe": "node scripts/download-repoe.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^4.0.13",
    "@types/node": "^24.10.1"
  }
}
